{% comment %}
  Phase 2: Delay marketing/analytics until user interaction.
  Add to theme.liquid before </body> on all templates (or product only).
{% endcomment %}
<script>
  (function () {
    var fired = false;

    function loadDeferredThirdParty() {
      if (fired) {
        return;
      }
      fired = true;

      document.removeEventListener('scroll', loadDeferredThirdParty, { capture: true });
      document.removeEventListener('click', loadDeferredThirdParty, { capture: true });
      document.removeEventListener('touchstart', loadDeferredThirdParty, { capture: true });
      document.removeEventListener('keydown', loadDeferredThirdParty, { capture: true });

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'delayedAnalytics' });

      if (window.gtag) {
        try {
          window.gtag('event', 'delayed_load', { send_to: 'all' });
        } catch (e) {}
      }
    }

    function scheduleFallback() {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(function () {
          setTimeout(loadDeferredThirdParty, 4000);
        }, { timeout: 5000 });
      } else {
        setTimeout(loadDeferredThirdParty, 4000);
      }
    }

    document.addEventListener('scroll', loadDeferredThirdParty, { capture: true, passive: true, once: true });
    document.addEventListener('click', loadDeferredThirdParty, { capture: true, once: true });
    document.addEventListener('touchstart', loadDeferredThirdParty, { capture: true, passive: true, once: true });
    document.addEventListener('keydown', loadDeferredThirdParty, { capture: true, once: true });

    if (document.readyState === 'complete') {
      scheduleFallback();
    } else {
      window.addEventListener('load', scheduleFallback);
    }
  })();
</script>
