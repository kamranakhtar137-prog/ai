{% comment %}
  Single async Google Tag Manager loader.

  Replaces individually hardcoded <script> tags for Crazy Egg, Microsoft
  Clarity, ClickCease, Facebook Pixel, etc. with ONE async request. GTM then
  fires each of those as a tag, on whatever trigger you configure in the GTM
  UI (see GTM-THIRD-PARTY-CONSOLIDATION.md).

  Install:
    1. Replace GTM-XXXXXXX below with your real container ID.
    2. Add {% render 'theme-gtm-loader' %} near the top of <head> in
       layout/theme.liquid (as high as possible, since it's async it will
       not block rendering).
    3. Add the matching <noscript><iframe ...></noscript> immediately after
       the opening <body> tag (required by Google, keep this even though
       most users have JS enabled — it's the documented install pattern).
{% endcomment %}
<script>
(function (w, d, s, l, i) {
  w[l] = w[l] || [];
  w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
  var f = d.getElementsByTagName(s)[0],
    j = d.createElement(s),
    dl = l != 'dataLayer' ? '&l=' + l : '';
  j.async = true;
  j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
  f.parentNode.insertBefore(j, f);
})(window, document, 'script', 'dataLayer', 'GTM-XXXXXXX');
</script>
