{% comment %}
  PageSpeed-optimized product gallery snippet.

  Performance changes vs default:
  - Gallery markup renders first (LCP image is not blocked by CSS/JS)
  - Removed unused image_list Liquid loop and per-image URL captures
  - Right-sized srcset/sizes for mobile LCP
  - Zoom/lightbox CSS + JS + DOM markup all load only on user interaction
    (the lightbox modal's HTML is now built by JS on first click instead of
    being rendered into every page load — see ensureLightboxMarkup() below)
{% endcomment %}

{%- assign gallery_sizes = '(max-width: 798px) calc(100vw - 32px), (max-width: 1200px) 60vw, 38vw' -%}

{{ 'product-gallery-zoom.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-gallery-hover-zoom.js' | asset_url }}" defer></script>

<div class="gallery-wrap
            gallery-arrows--{{ gallery_arrows }}
            {% if set_product_height != blank %}product-height-set{% endif %}
            gallery-thumbnails--{{ gallery_thumbnail_position }}">
  <div class="product_gallery
              js-product-gallery product-{{ product.id }}-gallery
              transparentBackground--{{ settings.slideshow_button_style }}
              slideshow-transition--{{ gallery_slideshow_transition }}
              popup-enabled--{{ gallery_click_to_zoom }}
              show-gallery-arrows--{{ gallery_arrows }}
              {% if product.media.size > 1 %} multi-image {% else %} single-image {% endif %}"
              data-thumbnails-enabled="{{ gallery_thumbnails }}"
              data-gallery-arrows-enabled="{{ gallery_arrows }}"
              data-slideshow-speed="{{ gallery_slideshow_speed }}"
              data-thumbnails-position="{{ gallery_thumbnail_position }}"
              data-thumbnails-slider-enabled="{{ gallery_thumbnail_slider }}"
              data-zoom="false"
              data-video-loop="{{ video_looping }}"
              data-product-id="{{ product.id }}"
              data-product-lightbox="{{ gallery_click_to_zoom }}"
              data-media-count="{{ product.media.size }}"
              data-product-gallery>

    {% for media in product.media %}
      {%- liquid
        assign image_alt = media.alt | escape
        assign is_first_media = forloop.first
        assign lazyload = true
        if is_first_media
          assign lazyload = false
        endif
      -%}

      <div class="gallery-cell" data-product-id="{{ product.id }}" data-media-type="{% if media.alt contains 'youtube' or media.alt contains 'vimeo' %}external_video{% else %}{{ media.media_type }}{% endif %}" data-title="{% if image_alt contains 'youtube' or image_alt contains 'vimeo' %}{{ product.title | escape }}{% else %}{{ image_alt }}{% endif %}">
        {% case media.media_type %}
          {% when 'image' %}
            {%- capture image_zoom -%}{{ media | image_url: width: 2048 }}{%- endcapture -%}

            {% if image_alt contains 'youtube' or image_alt contains 'vimeo' %}
              {% assign alt_text = image_alt | split: ' ' %}
              {% for property in alt_text %}
                {% if property contains "src" %}
                  {% assign cleanURL = property | remove: 'src=' | remove: '&quot;' | remove: '"' %}
                  <div class="product-gallery__video" data-youtube-video>
                    <iframe src="{{ cleanURL }}" frameborder="0" loading="lazy" title="{{ product.title | escape }}"></iframe>
                  </div>
                {% endif %}
              {% endfor %}
            {% else %}
              {% if gallery_click_to_zoom and product.images.size > 0 %}
                <a href="{{ image_zoom }}"
                   class="product-lightbox-trigger"
                   data-lightbox-index="{{ forloop.index0 }}"
                   data-zoom-src="{{ image_zoom }}"
                   data-zoom-alt="{{ image_alt }}"
                   tabindex="-1">
              {% endif %}

              <div
                class="image__container"
                style="max-width: {{ media.width }}px; --gallery-aspect-ratio: {{ media.width }} / {{ media.height }};"
              >
                {% if product.images.size > 0 %}
                  <div class="zoom-container">

                  {%- if lazyload -%}
                    {%- capture srcset -%}
                      {{ media | image_url: width: 1200 }} 1200w,
                      {{ media | image_url: width: 800 }} 800w,
                      {{ media | image_url: width: 600 }} 600w,
                      {{ media | image_url: width: 400 }} 400w
                    {%- endcapture -%}
                    <img loading="lazy"
                      decoding="async"
                      data-zoom-src="{{ image_zoom }}"
                      alt="{{ image_alt }}"
                      class="product-gallery__image lazyload {{ settings.image_loading_style }}"
                      data-image-id="{{ media.id }}"
                      data-index="{{ forloop.index0 }}"
                      sizes="{{ gallery_sizes }}"
                      data-aspectratio="{{ media.width }}/{{ media.height }}"
                      data-src="{{ media | image_url: width: 600 }}"
                      data-srcset="{{ srcset }}"
                      height="{{ media.height }}"
                      width="{{ media.width }}"
                      srcset="data:image/svg+xml;utf8,<svg%20xmlns='http://www.w3.org/2000/svg'%20width='{{ media.width }}'%20height='{{ media.height }}'></svg>"
                    />
                  {%- else -%}
                    {%- capture srcset -%}
                      {{ media | image_url: width: 1000 }} 1000w,
                      {{ media | image_url: width: 800 }} 800w,
                      {{ media | image_url: width: 600 }} 600w,
                      {{ media | image_url: width: 500 }} 500w,
                      {{ media | image_url: width: 400 }} 400w
                    {%- endcapture -%}
                    {{
                      media
                      | image_url: width: 500
                      | image_tag:
                        loading: 'eager',
                        fetchpriority: 'high',
                        decoding: 'async',
                        class: 'product-gallery__image',
                        alt: image_alt,
                        width: media.width,
                        height: media.height,
                        sizes: gallery_sizes,
                        srcset: srcset,
                        data-image-id: media.id,
                        data-index: forloop.index0,
                        data-zoom-src: image_zoom
                    }}
                  {%- endif -%}

                  </div>
                {% else %}
                  <img loading="lazy" decoding="async" width="800" height="1200" src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" />
                {% endif %}
              </div>

              {% if gallery_click_to_zoom and product.images.size > 0 %}
                </a>
              {% endif %}
            {% endif %}
          {% when 'external_video' %}
            <div class="product-gallery__video" data-youtube-video>
              {{ media | external_video_tag }}
            </div>
          {% when 'video' %}
            <div class="product-gallery__video" data-html5-video>
              {{ media | video_tag: controls: true }}
            </div>
          {% when 'model' %}
            <div class="product-gallery__model">
              {{ media | model_viewer_tag: reveal: 'interaction', toggleable: true, image_size: '800x800' }}

              <button class="view-in-your-space" data-shopify-xr data-shopify-model3d-id="{{ media.id }}" data-shopify-title={{ product.title | escape }} style="display: none;">
                <svg width="33" height="33" viewBox="0 0 33 33" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M16 9L22.0622 12.5V19.5L16 23L9.93782 19.5V12.5L16 9Z" stroke="#3A3A3A" stroke-width="1.5"/>
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M16 23V15.6024C16.6225 15.2002 16.6225 15.2002 16.6225 15.2002L22 12V19.4082L16 23Z" fill="#3A3A3A"/>
                </svg>
                {{ 'products.product.view_in_your_space' | t | capitalize }}
              </button>
            </div>
          {% else %}
            {{ media | media_tag }}
        {% endcase %}
      </div>
    {% endfor %}
  </div>

  {% if gallery_thumbnails == true %}
    {% if image_width != 'full' %}
      <div class="
            product_gallery_nav
            {% unless gallery_thumbnail_slider %}
              product_gallery_nav--slider-enabled
            {% endunless %}
            product-gallery__thumbnails
            product_gallery_nav--{{ thumbnail_position }}
            product-{{ product.id }}-gallery-nav
          ">
        {% if product.media.size > 1 %}
          {% for media in product.media %}
            {% if media.media_type contains 'video' %}
              {% assign thumbnail_badge = 'video-thumbnail' %}
            {% elsif media.media_type contains 'model' %}
              {% assign thumbnail_badge = '3d-thumbnail' %}
            {% else %}
              {% assign thumbnail_badge = '' %}
            {% endif %}

            <div tabindex="0" class="gallery-cell product-gallery__thumbnail" data-title="{{ media.alt | escape }}">
              {%
                render 'image-element',
                image: media,
                alt: media.alt,
                loading: 'lazy',
              %}
              {% if thumbnail_badge == 'video-thumbnail' %}
                <svg class="media-badge" width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path fill-rule="evenodd" clip-rule="evenodd" d="M1 25H25V1H1V25Z" fill="white"/><path class="media-badge__outline" d="M0.5 25V25.5H1H25H25.5V25V1V0.5H25H1H0.5V1V25Z" stroke="black" stroke-opacity="0.05"/><path fill-rule="evenodd" clip-rule="evenodd" d="M8.19995 5.8V20.2L19.3999 12.5858L8.19995 5.8Z" fill="#3A3A3A" fill-opacity="0.6"/></svg>
              {% elsif thumbnail_badge == '3d-thumbnail' %}
                <svg class="media-badge" width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path fill-rule="evenodd" clip-rule="evenodd" d="M1 25H25V1H1V25Z" fill="white"/><path class="media-badge__outline" d="M0.5 25V25.5H1H25H25.5V25V1V0.5H25H1H0.5V1V25Z" stroke="black" stroke-opacity="0.05"/><g opacity="0.6"><path fill-rule="evenodd" clip-rule="evenodd" d="M13 6L19.0622 9.5V16.5L13 20L6.93782 16.5V9.5L13 6Z" stroke="#3A3A3A" stroke-width="1.5"/><path fill-rule="evenodd" clip-rule="evenodd" d="M13 20V12.6024C13.6225 12.2002 13.6225 12.2002 13.6225 12.2002L19 9V16.4082L13 20Z" fill="#3A3A3A"/></g></svg>
              {% endif %}
            </div>
          {% endfor %}
        {% endif %}
      </div>
    {% endif %}
  {% endif %}
</div>

{% style %}
.shopify-model-viewer-ui model-viewer {
  --progress-bar-height: 2px;
  --progress-bar-color: {{ settings.regular_color }};
}
{% endstyle %}

{% comment %}
  The lightbox modal markup below used to be rendered here unconditionally
  (an empty, hidden <div> on every single product page load, even though
  gallery_click_to_zoom only means "clicking is allowed to zoom," not "the
  visitor clicked"). Its CSS/JS were already deferred until interaction —
  the DOM markup wasn't, which was inconsistent and added dead HTML/DOM
  nodes to every mobile page load. It's now built by ensureLightboxMarkup()
  below, at the same moment the CSS/JS are requested (first click), instead
  of being part of the initial server-rendered HTML.
{% endcomment %}

{% if gallery_click_to_zoom or gallery_hover_zoom %}
<script>
  (function () {
    function initializeGallery() {
      var productId = '{{ product.id }}';
      var gallery = document.querySelector('.product-' + productId + '-gallery');
      if (!gallery) {
        return false;
      }

      var debugEnabled = window.location.search.indexOf('gallery-debug=1') !== -1;
      var zoomCssLoaded = false;
      var lightboxJsPromise;
      var hoverJsPromise;

    function debug(message, details) {
      if (debugEnabled && window.console) {
        console.info('[Product gallery]', message, details || '');
      }
    }

    debug('Initialized.', {
      productId: productId,
      clickToZoom: {{ gallery_click_to_zoom | json }},
      hoverZoom: {{ gallery_hover_zoom | json }},
      mediaCount: {{ product.media.size }}
    });

    function loadStylesheet(href) {
      if (zoomCssLoaded) {
        return Promise.resolve();
      }

      zoomCssLoaded = true;
      return new Promise(function (resolve) {
        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = href;
        link.onload = function () {
          debug('Zoom stylesheet loaded.', { href: href });
          resolve();
        };
        link.onerror = function () {
          console.error('[Product gallery] Zoom stylesheet failed to load.', { href: href });
          resolve();
        };
        document.head.appendChild(link);
      });
    }

    function loadScript(src) {
      return new Promise(function (resolve) {
        var script = document.createElement('script');
        script.src = src;
        script.defer = true;
        script.onload = function () {
          debug('Script loaded.', { src: src });
          resolve();
        };
        script.onerror = function () {
          console.error('[Product gallery] Script failed to load.', { src: src });
          resolve();
        };
        document.body.appendChild(script);
      });
    }

    function ensureZoomCss() {
      return loadStylesheet('{{ "product-gallery-zoom.css" | asset_url }}');
    }

    function ensureLightboxJs() {
      if (!lightboxJsPromise) {
        lightboxJsPromise = loadScript('{{ "product-gallery-lightbox.js" | asset_url }}');
      }
      return lightboxJsPromise;
    }

    {% if gallery_click_to_zoom %}
    var lightboxMarkupCreated = false;

    function ensureLightboxMarkup() {
      if (lightboxMarkupCreated || document.querySelector('.product-lightbox--' + productId)) {
        lightboxMarkupCreated = true;
        return;
      }

      var wrapper = document.createElement('div');
      wrapper.innerHTML =
        '<div class="product-lightbox product-lightbox--' + productId + '" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Product image zoom">' +
          '<button type="button" class="product-lightbox__close" aria-label="Close">\u00D7</button>' +
          '<button type="button" class="product-lightbox__prev" aria-label="Previous image">\u2039</button>' +
          '<button type="button" class="product-lightbox__next" aria-label="Next image">\u203A</button>' +
          '<div class="product-lightbox__stage">' +
            '<div class="product-lightbox__content">' +
              '<img class="product-lightbox__image" src="" alt="" draggable="false" decoding="async">' +
            '</div>' +
          '</div>' +
          '<div class="product-lightbox__lens" aria-hidden="true">' +
            '<img class="product-lightbox__lens-img" src="" alt="" draggable="false" decoding="async">' +
          '</div>' +
          '<div class="product-lightbox__hint"></div>' +
          '<div class="product-lightbox__zoom-level" aria-live="polite"></div>' +
        '</div>';

      document.body.appendChild(wrapper.firstElementChild);
      lightboxMarkupCreated = true;
    }
    {% endif %}

    function ensureHoverJs() {
      if (!hoverJsPromise) {
        hoverJsPromise = loadScript('{{ "product-gallery-hover-zoom.js" | asset_url }}');
      }
      return hoverJsPromise;
    }

    {% if gallery_click_to_zoom %}
    gallery.addEventListener('click', function (event) {
      var trigger = event.target.closest('.product-lightbox-trigger');
      if (!trigger) {
        return;
      }

      event.preventDefault();
      ensureLightboxMarkup();

      var index = parseInt(trigger.getAttribute('data-lightbox-index'), 10);
      if (isNaN(index)) {
        index = 0;
      }

      Promise.all([ensureZoomCss(), ensureLightboxJs()]).then(function () {
        if (window.ProductGalleryLightbox) {
          window.ProductGalleryLightbox.open(productId, index);
        }
      });
    }, true);
    {% endif %}

    {% if gallery_hover_zoom %}
    var hoverAssetsLoading = false;
    var hoverAssetsReady = false;

    function loadHoverZoomAssets() {
      if (hoverAssetsReady) {
        if (window.ProductGalleryHoverZoom) {
          window.ProductGalleryHoverZoom.init(productId);
        }
        return Promise.resolve();
      }

      if (hoverAssetsLoading) {
        return hoverJsPromise || Promise.resolve();
      }

      hoverAssetsLoading = true;

      return Promise.all([ensureZoomCss(), ensureHoverJs()]).then(function () {
        hoverAssetsReady = true;
        if (window.ProductGalleryHoverZoom) {
          window.ProductGalleryHoverZoom.init(productId);
        }
      });
    }

    function onHoverIntent() {
      if (window.matchMedia('(hover: none) and (pointer: coarse)').matches) {
        debug('Hover zoom skipped on a coarse-pointer device.');
        return;
      }

      gallery.removeEventListener('mouseenter', onHoverIntent);
      gallery.removeEventListener('mousemove', onHoverIntent);
      debug('Hover intent detected; loading hover zoom assets.');
      loadHoverZoomAssets().then(function () {
        if (!window.ProductGalleryHoverZoom) {
          console.error('[Product gallery] Hover zoom script loaded but did not expose ProductGalleryHoverZoom.');
        }
      });
    }

    /*
      Load the custom hover lens as soon as this gallery is parsed instead of
      waiting for the first pointer event. This makes the lens available for
      galleries that Flickity initializes or refreshes after page load.
    */
    if (!window.matchMedia('(hover: none) and (pointer: coarse)').matches) {
      debug('Eagerly loading hover zoom assets.');
      loadHoverZoomAssets().then(function () {
        if (!window.ProductGalleryHoverZoom) {
          console.error('[Product gallery] Hover zoom script loaded but did not expose ProductGalleryHoverZoom.');
        }
      });
    }

    gallery.addEventListener('mouseenter', onHoverIntent, { passive: true });
    gallery.addEventListener('mousemove', onHoverIntent, { passive: true });
      {% endif %}
      return true;
    }

    var galleryInitializationAttempts = 0;

    function initializeWhenGalleryExists() {
      if (initializeGallery()) {
        return;
      }

      galleryInitializationAttempts += 1;
      if (galleryInitializationAttempts < 20) {
        window.setTimeout(initializeWhenGalleryExists, 50);
        return;
      }

      console.warn('[Product gallery] Gallery element was not found after waiting for the page to render.', {
        productId: '{{ product.id }}'
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeWhenGalleryExists, { once: true });
    } else {
      initializeWhenGalleryExists();
    }
  })();
</script>
{% endif %}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.ProductGalleryHoverZoom) {
      window.ProductGalleryHoverZoom.init('{{ product.id }}');
    } else {
      console.error('[Product gallery] product-gallery-hover-zoom.js did not load.');
    }
  });
</script>
