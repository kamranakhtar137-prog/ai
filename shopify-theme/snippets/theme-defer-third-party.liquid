{% comment %}
  Fires a `delayedAnalytics` dataLayer event on first scroll/click/touch/
  keydown, or after the page has been idle for ~4s if the visitor never
  interacts. Use this event as a Custom Event trigger in GTM for tags that
  don't need to run at the exact moment the page loads (Crazy Egg,
  Microsoft Clarity, Facebook Pixel, etc.) — see
  GTM-THIRD-PARTY-CONSOLIDATION.md for exactly which tags to wire to it and
  which (ClickCease) should NOT use this trigger.

  Install: add {% render 'theme-defer-third-party' %} in layout/theme.liquid
  right before </body>.
{% endcomment %}
<script>
  (function () {
    var fired = false;

    function fireDelayedAnalytics() {
      if (fired) {
        return;
      }
      fired = true;

      document.removeEventListener('scroll', fireDelayedAnalytics, { capture: true });
      document.removeEventListener('click', fireDelayedAnalytics, { capture: true });
      document.removeEventListener('touchstart', fireDelayedAnalytics, { capture: true });
      document.removeEventListener('keydown', fireDelayedAnalytics, { capture: true });

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'delayedAnalytics' });
    }

    function scheduleFallback() {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(function () {
          setTimeout(fireDelayedAnalytics, 4000);
        }, { timeout: 5000 });
      } else {
        setTimeout(fireDelayedAnalytics, 4000);
      }
    }

    document.addEventListener('scroll', fireDelayedAnalytics, { capture: true, passive: true, once: true });
    document.addEventListener('click', fireDelayedAnalytics, { capture: true, once: true });
    document.addEventListener('touchstart', fireDelayedAnalytics, { capture: true, passive: true, once: true });
    document.addEventListener('keydown', fireDelayedAnalytics, { capture: true, once: true });

    if (document.readyState === 'complete') {
      scheduleFallback();
    } else {
      window.addEventListener('load', scheduleFallback);
    }
  })();
</script>
